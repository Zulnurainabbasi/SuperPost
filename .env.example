# ==============================================================================
# SuperPost Environment Configuration (.env.example)
# Supports Vercel Serverless, Docker Compose, and Cloud Run Deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application & AI Engine
# ------------------------------------------------------------------------------
# Required for SuperPost AI Copilot & Viral Hook Generation (Google Gemini API)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# The public canonical URL of the application (e.g., https://superpost.vercel.app)
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Supabase / Neon)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (PgBouncer) for serverless
DATABASE_URL="postgresql://postgres:password@db.supabase.co:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations
DIRECT_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. Redis & Temporal Background Jobs (Optional for self-hosted queue)
# ------------------------------------------------------------------------------
REDIS_URL="redis://default:password@redis.upstash.io:6379"
TEMPORAL_ADDRESS="localhost:7233"

# ------------------------------------------------------------------------------
# 4. Authentication & Security Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="superpost_super_secret_jwt_key_at_least_32_characters"
NEXTAUTH_SECRET="superpost_nextauth_secret_random_hex_string"

# ------------------------------------------------------------------------------
# 5. Media Cloud Storage (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="superpost-media"
CLOUDFLARE_R2_PUBLIC_URL="https://media.superpost.io"

# ------------------------------------------------------------------------------
# 6. Billing & Payments (Stripe)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
